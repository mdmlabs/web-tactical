# MDM-labs Frontend Docker Environment Configuration
# Copy this file to .env and adjust values for your environment

# Backend API endpoint (REST API)
API_URL=https://api.example.com

# gRPC-Web API endpoint
GRPC_API_URL=https://grpc.example.com

# Application version (optional, defaults to package.json version)
APP_VERSION=0.101.56

# Logging level (optional, defaults to info)
# Options: debug, info, warn, error
LOG_LEVEL=info

# Build arguments (optional)
PROTOC_VERSION=25.1
GRPC_WEB_VERSION=1.5.0

{
  "name": "web",
  "version": "0.101.56",
  "private": true,
  "productName": "Hệ thống quản lý nghiệp vụ Cơ yếu trên nền tảng Window",
  "scripts": {
    "serve": "quasar dev",
    "build": "quasar build",
    "lint": "eslint --ext .js,.ts,.vue ./",
    "format": "prettier --write \"**/*.{js,ts,vue,,html,md,json}\" --ignore-path .gitignore",
    "proto:generate": "protoc --experimental_allow_proto3_optional -I=./src/gpo/proto --js_out=import_style=es6,binary:./src/generated --grpc-web_out=import_style=typescript,mode=grpcwebtext:./src/generated ./src/gpo/proto/common/user.proto ./src/gpo/proto/common/node.proto ./src/gpo/proto/common/target.proto ./src/gpo/proto/common/policy.proto ./src/gpo/proto/common/workspace.proto ./src/gpo/proto/common/export.proto ./src/gpo/proto/operator.proto ./src/gpo/proto/user_service.proto ./src/gpo/proto/agent_category_service.proto ./src/gpo/proto/wsl_lifecycle_service.proto ./src/gpo/proto/operator/alerts_service.proto ./src/gpo/proto/operator/connectivity_policy_service.proto ./src/gpo/proto/operator/vhd_service.proto ./src/gpo/proto/mesh.proto ./src/gpo/proto/mesh/user_service.proto ./src/gpo/proto/mesh/wsl_lifecycle_service.proto ./src/gpo/proto/mesh/vhd_service.proto ./src/gpo/proto/internal/vhd.proto && node scripts/post-process-proto.js",
    "proto:generate:mac": "PATH=$PATH:/opt/homebrew/bin protoc --experimental_allow_proto3_optional -I=./src/gpo/proto --js_out=import_style=es6,binary:./src/generated --grpc-web_out=import_style=typescript,mode=grpcwebtext:./src/generated ./src/gpo/proto/common/user.proto ./src/gpo/proto/common/node.proto ./src/gpo/proto/common/target.proto ./src/gpo/proto/common/policy.proto ./src/gpo/proto/common/workspace.proto ./src/gpo/proto/common/export.proto ./src/gpo/proto/operator.proto ./src/gpo/proto/user_service.proto ./src/gpo/proto/agent_category_service.proto ./src/gpo/proto/wsl_lifecycle_service.proto ./src/gpo/proto/operator/alerts_service.proto ./src/gpo/proto/operator/connectivity_policy_service.proto ./src/gpo/proto/operator/vhd_service.proto ./src/gpo/proto/mesh.proto ./src/gpo/proto/mesh/user_service.proto ./src/gpo/proto/mesh/wsl_lifecycle_service.proto ./src/gpo/proto/mesh/vhd_service.proto ./src/gpo/proto/internal/vhd.proto && node scripts/post-process-proto.js"
  },
  "dependencies": {
    "@quasar/extras": "1.16.17",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueuse/core": "11.2.0",
    "@vueuse/integrations": "11.2.0",
    "@vueuse/shared": "11.2.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "apexcharts": "3.54.1",
    "axios": "1.12.2",
    "dompurify": "3.2.6",
    "dotenv": "16.4.5",
    "google-protobuf": "^4.0.1",
    "grpc-web": "^2.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "monaco-editor": "0.50.0",
    "pinia": "2.2.6",
    "protobufjs": "^8.0.0",
    "qrcode": "1.5.4",
    "quasar": "2.18.5",
    "vue": "3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-router": "4.5.1",
    "vue3-apexcharts": "1.7.0",
    "vuedraggable": "4.1.0",
    "vuex": "4.1.0",
    "xlsx": "^0.18.5",
    "yaml": "2.6.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "4.0.0",
    "@quasar/app-vite": "1.10.2",
    "@quasar/cli": "2.4.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.7.5",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "autoprefixer": "10.4.20",
    "dotenv-expand": "^13.0.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-vue": "8.7.1",
    "http2-wrapper": "^2.2.1",
    "prettier": "3.3.3",
    "protoc-gen-js": "^3.21.4-4",
    "typescript": "5.9.2",
    "undici": "^7.18.2"
  }
}
